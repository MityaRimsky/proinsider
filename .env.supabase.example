# Supabase PostgreSQL connection settings for applying migrations via psql.
# Copy this file to .env.supabase and fill real values.
#
# For tunnel-based access, open SSH tunnel first, for example:
#   ssh -L 55432:localhost:5432 <user>@<server>
# Then keep DB_HOST=localhost and DB_PORT=55432.

DB_HOST="localhost"
DB_PORT="55432"
DB_USER="supabase_admin.<TENANT_ID>"
DB_PASSWORD="<POSTGRES_PASSWORD>"
DB_NAME="postgres"

# Optional API settings if needed by other scripts.
SUPABASE_URL="http://147.45.213.141:8000"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""