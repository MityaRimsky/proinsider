# Supabase PostgreSQL connection settings for applying migrations via psql.
# Copy this file to .env.supabase and fill real values.
#
# For tunnel-based access, open SSH tunnel first, for example:
#   ssh -L 55432:localhost:5432 <user>@<server>
# Then keep DB_HOST=localhost and DB_PORT=55432.

DB_HOST="localhost"
DB_PORT="55432"
DB_USER="supabase_admin.<TENANT_ID>"
DB_PASSWORD="<POSTGRES_PASSWORD>"
DB_NAME="postgres"

# Optional API settings if needed by other scripts.
SUPABASE_URL="http://147.45.213.141:8000"
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# CloudPayments settings for Supabase Edge Functions.
# Public ID is used as Basic Auth login for server API requests.
# API Secret is used only on the server and must never be exposed to the app.
CLOUDPAYMENTS_PUBLIC_ID=""
CLOUDPAYMENTS_API_SECRET=""
CLOUDPAYMENTS_SUCCESS_REDIRECT_URL=""
CLOUDPAYMENTS_FAIL_REDIRECT_URL=""
CLOUDPAYMENTS_EXPECT_TEST_MODE="false"